# Copy to bots/storage_bot/.env and fill in
BOT_TOKEN=your_telegram_bot_token_here

# Metadata database path. Files are stored in <db folder>/storage/<user_id>/...
DB_PATH=data/storage.db

# Proxy to api.telegram.org if direct access is blocked (otherwise leave empty)
# BOT_PROXY=http://127.0.0.1:8080
